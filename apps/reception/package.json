{
  "name": "@pip/reception",
  "version": "0.9.5",
  "private": true,
  "author": "Blackworks",
  "main": "src/main.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev:about": "env -u ELECTRON_RUN_AS_NODE PIP_SHOW_ABOUT=1 electron .",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "dependencies": {
    "@pip/shared": "0.6.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "42.1.0"
  },
  "build": {
    "appId": "com.patientpip.reception",
    "productName": "Pip Reception",
    "icon": "build/icon.png",
    "copyright": "Copyright Blackworks",
    "directories": {
      "output": "../../dist/reception"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../config/config.json",
        "to": "config/config.json"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/assets/sounds/**/*.wav"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
