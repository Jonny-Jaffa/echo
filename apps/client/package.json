{
  "name": "@pip/client",
  "version": "0.8.14",
  "private": true,
  "author": "Blackworks",
  "type": "module",
  "main": "src/panel-main.cjs",
  "scripts": {
    "dev": "node src/index.js",
    "dev:panel": "env -u ELECTRON_RUN_AS_NODE electron src/panel-main.cjs",
    "dev:panel:room2": "env -u ELECTRON_RUN_AS_NODE PIP_DEVICE_ID=pip-room-panel-2 PIP_ROOM_ID=surgery-2 electron --user-data-dir=.pip-room-panel-2 src/panel-main.cjs",
    "start": "node src/index.js",
    "start:panel": "env -u ELECTRON_RUN_AS_NODE electron src/panel-main.cjs",
    "test:surgeries": "node src/test-all-surgeries.js"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.2",
    "@pip/shared": "0.6.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "42.1.0"
  },
  "build": {
    "appId": "com.patientpip.surgery",
    "productName": "Pip Surgery",
    "icon": "build/icon.png",
    "copyright": "Copyright Blackworks",
    "directories": {
      "output": "../../dist/surgery"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../../config/config.json",
        "to": "config/config.json"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm",
      "src/assets/sounds/**/*.wav"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
