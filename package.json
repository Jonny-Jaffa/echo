{
  "name": "pip",
  "version": "0.8.1",
  "private": true,
  "author": "Blackworks",
  "description": "Pip cross-platform reception and client room notification system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:reception": "npm run dev -w @pip/reception",
    "dev:reception:about": "npm run dev:about -w @pip/reception",
    "dev:client": "npm run dev -w @pip/client",
    "dev:client:about": "npm run dev:about -w @pip/client",
    "dev:surgery:about": "npm run dev:client:about",
    "dev:client-panel": "npm run dev:panel -w @pip/client",
    "dev:client-panel:room2": "npm run dev:panel:room2 -w @pip/client",
    "dev:all-panels": "./scripts/run-dev-all-panels.sh",
    "test:clients": "npm run test:surgeries -w @pip/client",
    "test:surgeries": "npm run test:clients",
    "start:reception": "npm run start -w @pip/reception",
    "start:reception:mac-test": "./scripts/run-reception-mac-test.sh",
    "start:client": "npm run start -w @pip/client",
    "build:reception:mac": "electron-builder --projectDir apps/reception --mac dmg zip",
    "build:client:mac": "electron-builder --projectDir apps/client --mac dmg zip",
    "build:surgery:mac": "npm run build:client:mac",
    "build:reception:win": "electron-builder --projectDir apps/reception --win nsis zip --x64",
    "build:client:win": "electron-builder --projectDir apps/client --win nsis zip --x64",
    "build:surgery:win": "npm run build:client:win",
    "build:reception:win:x64": "electron-builder --projectDir apps/reception --win nsis zip --x64",
    "build:client:win:x64": "electron-builder --projectDir apps/client --win nsis zip --x64",
    "build:surgery:win:x64": "npm run build:client:win:x64",
    "build:all:win": "npm run build:reception:win && npm run build:client:win",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=20"
  }
}
