.DS_Store

# Dependencies
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Build outputs
dist/
out/
release/

# Local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.orig
*.rej

# Local backup copy kept outside version control
old version/

